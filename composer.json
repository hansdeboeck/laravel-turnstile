{
    "name": "hansdeboeck/laravel-turnstile",
    "description": "Cloudflare Turnstile voor Laravel: serverside verificatie, validatieregel, Blade-componenten en de bijhorende JavaScript.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "cloudflare", "turnstile", "captcha", "bot", "blade"],
    "authors": [
        {
            "name": "Hans De Boeck"
        }
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.9|^8.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/log": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "HansDeBoeck\\Turnstile\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HansDeBoeck\\Turnstile\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HansDeBoeck\\Turnstile\\TurnstileServiceProvider"
            ],
            "aliases": {
                "Turnstile": "HansDeBoeck\\Turnstile\\Facades\\Turnstile"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
